        "finding": null,
        "missing_fact": "A deterministic branch for this row has not been implemented.",
        "required_input": "row-resolver",
        "next_category": "row-implementation"
      },
      "rationale": "Owner evidence cannot be inferred from a fixture before row implementation.",
