<Project>
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>

  <Import Project="$(MSBuildSDKsPath)/Microsoft.NET.Sdk/Sdk/Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>BlazorComponentReadiness.ContractTests</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="../../../plugins/dotnet-blazor-component-readiness/skills/blazor-component-readiness/scripts/validator/**/*.cs"
      Exclude="../../../plugins/dotnet-blazor-component-readiness/skills/blazor-component-readiness/scripts/validator/Program.cs"
      LinkBase="ValidatorSource" />
  </ItemGroup>

  <Import Project="$(MSBuildSDKsPath)/Microsoft.NET.Sdk/Sdk/Sdk.targets" />

  <Target Name="VerifyNoPackageReferences">
    <Error
      Condition="'@(PackageReference)' != ''"
      Text="Readiness validator tests must remain BCL-only: @(PackageReference)." />
  </Target>
</Project>
